{
  "name": "dashboardd",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "crates/dashboardd-server/frontend",
    "crates/dashboardd-desktop/frontend",
    "widgets/*/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "docs:assets": "mdbook-mermaid install docs",
    "docs:build": "npm run docs:assets && mdbook build docs",
    "docs:serve": "npm run docs:assets && mdbook serve docs --open",
    "format": "prettier --write \"{packages,crates/*/frontend,widgets,tests,schemas}/**/*.{ts,js,mjs,html,css,json}\" \"{docs,.github}/**/*.{md,yml}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{packages,crates/*/frontend,widgets,tests,schemas}/**/*.{ts,js,mjs,html,css,json}\" \"{docs,.github}/**/*.{md,yml}\" \"*.{json,md}\"",
    "test:contracts": "node tests/contracts.mjs",
    "test:sdk": "node tests/sdk-package.mjs",
    "test": "npm run test:contracts && npm run test:sdk && node tests/browser.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "playwright-core": "^1.55.0",
    "prettier": "^3.5.3"
  }
}
