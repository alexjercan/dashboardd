{
  "name": "@dashboardd/widget-sdk",
  "version": "0.2.0",
  "description": "Frontend types, lifecycle helpers, and styles for dashboardd widgets",
  "license": "MIT",
  "type": "module",
  "homepage": "https://alexjercan.github.io/dashboardd/widget-authoring/frontend.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexjercan/dashboardd.git",
    "directory": "packages/widget-sdk"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/theme.css"
    },
    "./widget.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/widget.css"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
